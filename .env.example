# .env.example — hybrid-rag-pipeline
# Copy to .env and fill in values to activate live backends. Leave blank for mock mode.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  PROGRESSIVE CREDENTIAL LOADING (PCL)                                   │
# │  No keys needed to run. Add keys to unlock production-grade backends.   │
# └─────────────────────────────────────────────────────────────────────────┘

# ── AI Providers ─────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic mock embeddings & answer generation (CI-safe)
# SET to OpenAI key (sk-...): Live text-embedding-3-small & GPT-4o-mini generation
OPENAI_API_KEY=

# ── Vector Database ───────────────────────────────────────────────────────
# Default: http://localhost:8000
CHROMA_URL=http://localhost:8000

# ── Models & Configuration ────────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
PORT=3000
LOG_LEVEL=info
